# Single source of truth for the FROM-SOURCE COMPILE version pins.
#
# Scope: only the versions a SHELL reads, scripts/fetch-base-image.sh (which
# builds from source when the published image cannot be pulled) and
# .github/workflows/base-images.yml (derives the image tag from
# OPENSSL_VERSION). A change here triggers a base-image
# rebuild (base-images.yml watches this file).
#
# NOT here, deliberately: the base-image DIGESTS (ubuntu:24.04@sha256, node,
# python, ...). A Dockerfile cannot source a .env, and, more importantly,
# those digests must live in the Dockerfiles/compose because that is where
# Dependabot reads and refreshes them (.github/dependabot.yml). Duplicating a
# digest here would only go stale and blind Dependabot to nothing.
#
# OpenSSL 3.5+ ships ML-KEM and ML-DSA in the default provider, so no external
# PQ provider is needed for post-quantum TLS.
OPENSSL_VERSION=3.6.2
# sha256 of the upstream source tarball, enforced by docker/base/openssl/Dockerfile's
# `ADD --checksum`. Bump together with OPENSSL_VERSION.
OPENSSL_SHA256=aaf51a1fe064384f811daeaeb4ec4dce7340ec8bd893027eee676af31e83a04f
OPENRESTY_VERSION=1.27.1.2
# sha256 of the upstream OpenResty source, enforced by docker/gateway/Dockerfile's
# `ADD --checksum`. Bump together with OPENRESTY_VERSION.
OPENRESTY_SHA256=74f076f7e364b2a99a6c5f9bb531c27610c78985abe956b442b192a2295f7548
# No NGINX_VERSION / NJS_VERSION: the gateway image compiles nginx from
# OpenResty (OPENRESTY_VERSION) instead.
