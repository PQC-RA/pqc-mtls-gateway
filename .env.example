# =============================================================================
# Deploy-time environment for the PQC TLS gateway stack.
# Copy to .env (gitignored) and fill in real per-tier values before deploying.
# CONSOLE_ORIGIN, CORS_ALLOWED_ORIGINS and AUDITOR_CERT_FINGERPRINTS below are
# REQUIRED at deploy, the
# image ships no defaults and is environment-agnostic; values are supplied here.
# =============================================================================

# SHA-256 fingerprint(s) of authorized admin client cert(s), comma-separated.
# Set per deployment (changes when the admin cert is re-issued). Fails closed if empty.
ADMIN_CERT_FINGERPRINTS=

# Comma-separated web origins allowed to call the management API (CORS).
# REQUIRED at deploy; per-tier. Empty = no cross-origin access.
# Example (multiple): CORS_ALLOWED_ORIGINS=https://console.example.local,https://api.example.local
CORS_ALLOWED_ORIGINS=https://console.example.local

# Console origin for CSRF protection on management-API writes. Takes precedence
# over CORS_ALLOWED_ORIGINS for write protection.
# REQUIRED at deploy.
# CRITICAL: empty/unset => the CSRF guard fails CLOSED => ALL console writes are denied.
# Set to the console origin, e.g. https://localhost:8443
CONSOLE_ORIGIN=https://console.example.local

# SHA-256 fingerprint(s) of read-only auditor client cert(s), comma-separated.
# Same format as ADMIN_CERT_FINGERPRINTS; auditors get GET-only access.
# REQUIRED at deploy to enable the auditor role; empty = no auditors.
AUDITOR_CERT_FINGERPRINTS=

# Lifetime of issued client certificates, in days. Interpolated into
# docker-compose.yml; defaults to 365 when unset.
CERT_VALIDITY_DAYS=365

# ── PKI bootstrap escape hatch (leave unset) ─────────────────────────────────
# scripts/setup-pki.sh refuses to build the client-facing CA hierarchy with a
# non-post-quantum KEY_ALG. Setting this to 1 disables that refusal, which
# produces a gateway whose certificate chain is NOT post-quantum. It exists so a
# deliberate classical comparison arm can be built; it has no place in a
# deployment. Unset or 0 keeps the refusal in force.
# PQC_ALLOW_CLASSICAL_CA=0
