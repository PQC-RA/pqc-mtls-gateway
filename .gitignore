# ── Secrets, NEVER commit ───────────────────────────────────────────────────
secrets/*.key
secrets/*.pem
*.key
*.pem
# (CA/server private keys, gateway signing key, control-plane HMAC, etc.)

# ── Deploy-specific env values (real values; commit .env.example instead) ─────
.env

# ── Generated PKI material & client artifacts (contain private keys) ──────────
client-cert-artifacts/
temp/
pki/out/
certs/

# ── Logs / runtime ───────────────────────────────────────────────────────────
*.log
scripts/build.log

# ── OS / editor ──────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
__pycache__/
*.pyc

# Bootstrap admin cert generated by deploy.sh (contains private key)
admin-cert/
