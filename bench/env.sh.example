# bench/env.sh.example: the paths and ports the harness uses.
#
# Only two of these are read from the environment. The rest are defaults compiled
# into the scripts and are listed here so you know what to change if your layout
# differs. Copy to env.sh and source it, or just export the two:
#
#   WORKDIR   where the harness builds PKIs and writes output. Unset, it resolves
#             to the directory the scripts live in. Several scripts REBUILD it,
#             so point it somewhere disposable.
#   EXPORT    the issued client identity for the live-gateway arms:
#             client.crt, client.key, ca-chain.crt. Defaults to
#             /root/measure-export.
#
# WORKDIR=
# EXPORT=

# --- PQ toolchain -------------------------------------------------------------
OSSL=/opt/openssl/bin/openssl         # OpenSSL >= 3.5 with native ML-KEM / ML-DSA
OPENSSL_CONF=/etc/ssl/openssl.cnf     # exported by every script
CURL=/usr/bin/curl                    # MUST be linked against $OSSL's library;
                                      # measure-latency.sh exits if `curl -V`
                                      # does not report OpenSSL 3.5+

# --- the deployment under test ------------------------------------------------
# REPO=                               # unset: the repository this bench/ sits in
GW=127.0.0.1                          # gateway address used by the probes
GW_HOSTNAME=pqc-gw.local              # used with curl --resolve so SNI is sent
GW_CONTAINER=pqc-gateway
BENCH_CN=bench-client                 # preflight.sh checks a route exists for it
DEPLOY_PKI=/etc/pki/pqc-ca            # the deployment's CA tree
CP_SECRET=$REPO/secrets/control-plane-hmac.key   # HMAC key, read not embedded
ROUTES=/var/cache/pqc-gw/routes/routes.json      # inside the container

# --- hermetic arms: setup-classical-arm.sh + add-pure-arm.sh ------------------
# Throwaway PKIs under $WORKDIR/hermetic, s_server on loopback.
PORT_HYBRID=4433
PORT_CLASSICAL=4434
PORT_PURE=4435
# rtt-proof.sh uses 4443/4444.

# --- matched-PKI arms: mk-matched-pki.sh + mk-arms.sh -------------------------
# A SEPARATE rig from the hermetic arms above, with its own PKIs and its own
# ports. Two three-tier PKIs identical except for the algorithm, served by the
# real gateway image with the entrypoint overridden to bare nginx.
MATCHED_PKI=$WORKDIR/pki              # mk-matched-pki.sh writes classical/ and pqc/
MATCHED_CONF=$WORKDIR/conf            # per-arm nginx.conf, written by mk-arms.sh
MATCHED_IMAGE=pqc-gateway:1.0.0
MATCHED_NET=pqc-gw_pqc-pki            # docker network the arms join
MATCHED_PORT_CLASSICAL=9443           # X25519 + ECDSA P-256       -> pki/classical
MATCHED_PORT_HYBRID=9444              # X25519MLKEM768 + ML-DSA-65 -> pki/pqc
MATCHED_PORT_PURE=9445                # MLKEM768 + ML-DSA-65       -> pki/pqc

# --- off-box concurrency ------------------------------------------------------
# concurrency-from-client.sh runs on a SECOND machine and needs an identity
# issued by THIS deployment's CA. Certificates from another deployment share the
# subject DN but not the key and will not validate.
#
# NOTE: if that machine is another guest on the same hypervisor it does not
# isolate the physical CPU, and the latency column measures client contention.
# See README, "What this harness cannot measure".
PROBE=$EXPORT                         # client.crt/.key/ca-chain.crt on that machine
VPN_BENCH_DIR=$HOME/vpn-bench
